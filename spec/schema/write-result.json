{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://srcp.dev/schema/0.1/write-result.json",
  "title": "SRCP Write Result",
  "type": "object",
  "required": ["status", "generation", "trace_id"],
  "additionalProperties": false,
  "properties": {
    "status": { "enum": ["COMMITTED", "CONFLICT", "QUEUED", "REJECTED"] },
    "generation": { "type": "integer", "minimum": 0 },
    "version_vector": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 } },
    "content_hash": { "type": "string" },
    "conflict": { "type": ["object", "null"] },
    "error": {
      "type": ["object", "null"],
      "properties": {
        "code": { "type": "string" },
        "message": { "type": "string" }
      },
      "required": ["code", "message"]
    },
    "trace_id": { "type": "string" }
  }
}
