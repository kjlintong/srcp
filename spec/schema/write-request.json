{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://srcp.dev/schema/0.1/write-request.json",
  "title": "SRCP Conditional Write Request",
  "type": "object",
  "required": ["resource_id", "principal", "lease_id", "expected_generation", "content", "idempotency_key"],
  "additionalProperties": false,
  "properties": {
    "resource_id": { "type": "string", "minLength": 1 },
    "principal": { "type": "string", "minLength": 1 },
    "lease_id": { "type": "string", "minLength": 1 },
    "expected_generation": { "type": "integer", "minimum": 0 },
    "expected_version_vector": {
      "type": "object",
      "additionalProperties": { "type": "integer", "minimum": 0 }
    },
    "content": { "type": "string" },
    "content_type": { "type": "string", "default": "text/plain" },
    "intent": { "type": "string", "maxLength": 1024, "default": "" },
    "idempotency_key": { "type": "string", "minLength": 1, "maxLength": 256 },
    "conflict_policy": { "enum": ["abort", "append", "merge", "lww", "manual"] },
    "deadline_ms": { "type": "integer", "minimum": 1, "maximum": 600000, "default": 5000 }
  }
}
